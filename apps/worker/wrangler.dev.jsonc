// Local development only (wrangler dev uses a local simulated D1). Not used for deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gart-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-15",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "UPDATER", "class_name": "Updater" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["Updater"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gart-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ]
}
